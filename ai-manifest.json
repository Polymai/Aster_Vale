{
  "version": "1.0",
  "intent": {
    "primaryGoal": "Enable safe, minimal changes",
    "priorities": [
      "prioritize stability over speed",
      "prefer minimal diffs",
      "avoid unrelated modifications"
    ]
  },
  "app": {
    "id": "PRODUCT GOAL Aster",
    "type": "tinyfiles",
    "summary": "PRODUCT GOAL Aster generated by Polymai as a Tinyfiles app."
  },
  "architecture": {
    "pattern": "tinyfiles",
    "maxDepth": 2,
    "entrypoints": [
      "index.html"
    ],
    "modules": [
      {
        "path": "index.html",
        "responsibility": "bootstrap shell"
      },
      {
        "path": "styles/site.css",
        "responsibility": "dependency for index.html"
      },
      {
        "path": "scripts/site.js",
        "responsibility": "dependency for index.html"
      },
      {
        "path": "css/base.css",
        "responsibility": "base reset and tokens"
      },
      {
        "path": "css/app.css",
        "responsibility": "app styling"
      },
      {
        "path": "js/state.js",
        "responsibility": "state store"
      }
    ]
  },
  "editingPolicy": {
    "rules": [
      "ONLY modify files explicitly identified for the task",
      "DO NOT modify files outside the identified scope",
      "DO NOT change unrelated code",
      "DO NOT introduce new architecture unless required",
      "DO NOT guess missing logic or requirements",
      "PREFER modifying existing files over creating new ones",
      "KEEP changes minimal"
    ],
    "allowedPaths": [
      "styles/",
      "scripts/",
      "assets/",
      "css/",
      "js/"
    ],
    "forbiddenPaths": [
      "index.html"
    ],
    "maxFilesPerChange": 3
  },
  "execution": {
    "steps": [
      "identify relevant files",
      "validate allowed scope",
      "do not proceed if scope is unclear",
      "apply minimal change",
      "verify no unrelated files were modified",
      "confirm changes are limited to relevant files"
    ]
  },
  "failureHandling": {
    "onUncertainty": "request_clarification",
    "onScopeViolation": "abort",
    "onMissingContext": "request_clarification"
  }
}
